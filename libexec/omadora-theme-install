#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=lib/common/init.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common/init.sh"

# shellcheck source=lib/theme.sh
source "$OMADORA_LIB_DIR/theme.sh"

yes=false

while [[ $# -gt 0 ]]; do
  case "$1" in
  -y | --yes)
    yes=true
    shift
    ;;
  -*)
    die "unknown option $1"
    ;;
  *)
    [[ -z "${url:-}" ]] || die "unexpected argument $1"
    url="$1"
    shift
    ;;
  esac
done

url="${url:-}"

[[ -n "$url" ]] || {
  die "missing theme repository URL"
}

"$OMADORA_LIBEXEC_DIR/omadora-git-url-check" "$url" ||
  die "invalid theme repository URL"

# Strip the user@host: prefix from scp-style SSH URLs so basename sees only
# the repository path.
repo_path="$url"
if [[ $repo_path != *"://"* && $repo_path == *:* && ${repo_path%%:*} != */* ]]; then
  repo_path="${repo_path#*:}"
fi

theme_name="$(
  basename -- "$repo_path" .git |
    sed -E 's/^(omarchy|omadora)-//; s/-theme$//' |
    tr '[:upper:]' '[:lower:]'
)"

if ! (LC_ALL=C; [[ $theme_name =~ ^[a-z0-9_][a-z0-9._+-]*$ ]]); then
  die "'$url' does not give a usable theme name"
fi

theme_path="$OMADORA_USER_THEMES_DIR/$theme_name"

if [[ "$yes" != true ]]; then
  cat <<'EOF'

+---------------------------------------------------------------------+
| Warning: third-party theme install                                  |
+---------------------------------------------------------------------+
| Themes can include files that run commands on your computer.        |
| Only install from trusted repositories, and verify the files first. |
+---------------------------------------------------------------------+

EOF

  confirm "Install third-party theme '$theme_name'?" || {
    info "Theme install cancelled."
    exit 0
  }
fi

info "Installing theme: $theme_name"

ensure_dir "$OMADORA_USER_THEMES_DIR"
stage_dir="$(mktemp -d "$OMADORA_CONFIG_HOME/.theme-install.XXXXXX")"
trap 'rm -rf -- "$stage_dir"' EXIT
stage_theme="$stage_dir/theme"

git clone -- "$url" "$stage_theme" ||
  die "failed to clone theme repository"

# Replace the source atomically with respect to theme switching. Both paths
# are on the same filesystem, so the final move cannot expose a partial clone.
exec 9>"$OMADORA_THEME_LOCK_FILE"
flock 9
rm -rf -- "$theme_path"
mv -- "$stage_theme" "$theme_path"
flock -u 9

# Apply the new theme
"$OMADORA_LIBEXEC_DIR/omadora-theme-set" "$theme_name" ||
  die "failed to apply theme"

info "Installed theme: $theme_name"
